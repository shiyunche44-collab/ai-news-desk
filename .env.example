# 复制成 .env 或者直接 export。这个文件只是告诉你有哪些变量，不要在这里填真实的 key。
# 本项目的代码只从环境变量读 key，不会写进任何文件或日志。

# DeepSeek（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=
# 阿里云百炼 / 通义千问（百炼控制台申请）
DASHSCOPE_API_KEY=
# Claude，只在评测里做对照（中国大陆不能直接用）
ANTHROPIC_API_KEY=
# 要对照的 Claude 模型名，以 Anthropic 官方模型列表为准
CLAUDE_MODEL=

# 可选：默认用哪个模型（mock / deepseek / qwen / claude），等同于命令行 --model
NEWSROOM_MODEL=
# 可选：GitHub 信息源的限额更高
GITHUB_TOKEN=
